# Environment variables read by config/settings/prod.py.
# Copy to .env, fill in real values, and load it however your deployment
# platform expects (most PaaS providers do this for you; otherwise
# `export $(cat .env | xargs)` or a tool like python-dotenv).
#
# DJANGO_SETTINGS_MODULE=config.settings.prod must also be set — it isn't
# listed below because it selects the settings module itself rather than
# configuring it.

# Required. Long random string, never committed. Generate one with:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=

# Required. Comma-separated hostnames this deployment serves.
DJANGO_ALLOWED_HOSTS=crs.example.edu

# Optional. Default "Asia/Jakarta".
DJANGO_TIME_ZONE=

# Optional. Set to "0" to disable the HTTPS redirect and secure-cookie flags
# (default on). Only turn this off if TLS is not available yet.
DJANGO_SECURE_SSL=1

# Optional. Absolute path to the SQLite file. Keep it outside the source tree
# so a redeploy cannot clobber it.
DJANGO_DB_PATH=/var/lib/crs/db.sqlite3
